APP_NAME=AquaPulse API
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development defaults only. Change these before any production deployment.
POSTGRES_DB=aquapulse
POSTGRES_USER=aquapulse
POSTGRES_PASSWORD=aquapulse
# Host port published by Docker Compose. Use 5433 if local PostgreSQL already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aquapulse:aquapulse@127.0.0.1:5432/aquapulse
SQL_ECHO=false

# Used only by pytest. Never point this at the development database.
TEST_DATABASE_URL=postgresql+psycopg://aquapulse:aquapulse@127.0.0.1:5432/aquapulse_test

# Development telemetry simulator. Never starts with FastAPI. Default is disabled.
TELEMETRY_SIMULATOR_ENABLED=false
TELEMETRY_SIMULATOR_INTERVAL_SECONDS=5
TELEMETRY_SIMULATOR_SPEED=1

# Agent integration readiness. All execution flags default disabled. Do not put secrets here.
# The Investigation and Response agents own their own LLM keys (for example GROQ).
#
# Readiness health checks use these URLs even when execution flags are false.
# They are host-local defaults. If AquaPulse runs inside Docker, 127.0.0.1 is the
# current container — set a Compose service hostname or host.docker.internal
# instead of treating either as a universal default.
# run.sh exports these from the configured ports when they are not already set.
AGENT_INTEGRATION_ENABLED=false
INVESTIGATION_AGENT_ENABLED=false
INVESTIGATION_AGENT_MODE=disabled
INVESTIGATION_AGENT_URL=http://127.0.0.1:8002
INVESTIGATION_AGENT_TIMEOUT_SECONDS=30
INVESTIGATION_AGENT_CONTRACT_VERSION=1.0
# Optional path override if the friend agent does not use POST /v1/investigate
# INVESTIGATION_AGENT_INVESTIGATE_PATH=/v1/investigate
NETWORK_AGENT_ENABLED=false
NETWORK_AGENT_URL=http://127.0.0.1:9001
RESPONSE_AGENT_ENABLED=false
RESPONSE_AGENT_MODE=disabled
RESPONSE_AGENT_URL=http://127.0.0.1:8004
RESPONSE_AGENT_TIMEOUT_SECONDS=30
RESPONSE_AGENT_CONTRACT_VERSION=1.0
# Optional path override if the friend agent does not use POST /v1/recommend-response
# RESPONSE_AGENT_RECOMMEND_PATH=/v1/recommend-response
AGENT_HEALTH_TIMEOUT_SECONDS=2
AGENT_HEALTH_CACHE_SECONDS=15
# Never seed dummy agent runs/findings/recommendations. Keep this false.
SEED_AGENT_DEMO_DATA=false
AGENT_RESULT_INGEST_ENABLED=true
AGENT_SUPPORT_SERVICES_MODE=mock
PHYSICAL_COMMANDS_ENABLED=false
REAL_NOTIFICATIONS_ENABLED=false
CAMARA_ENABLED=false

# Nokia Network as Code / CAMARA — called only by the AquaPulse backend.
# Default is demonstration/mock data. The app starts without credentials.
# Never commit a real API key. If a key was exposed in a screenshot or chat, revoke it.
NOKIA_NETWORK_API_ENABLED=false
NOKIA_NETWORK_API_MODE=mock
NOKIA_NETWORK_API_BASE_URL=
NOKIA_NETWORK_API_KEY=
NOKIA_NETWORK_API_HOST=
NOKIA_LOCATION_PATH=/location-retrieval/v0.3/retrieve
NOKIA_REACHABILITY_PATH=/device-reachability-status/v0.7/retrieve
NOKIA_NETWORK_TIMEOUT_SECONDS=10
NOKIA_NETWORK_CACHE_SECONDS=300
