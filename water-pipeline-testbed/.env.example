# Copy this file to `.env` to configure docker-compose.
#
# Optional: enables live LLM narration (Stage 4) via the Anthropic API.
# If left blank, aia_service falls back to the deterministic template
# narrator in aia/narration.py -- the rest of the pipeline is unaffected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
